# CustomOS x86_64 with over-the-air updates: the live/installable ISO of
# customos_x86_64_defconfig plus the A/B update system (RAUC, customos-updater,
# a squashfs system image for the A/B installer and the update bundles).
# Build: ./build.sh --ota   (or: make BR2_EXTERNAL=../br2-external customos_x86_64_ota_defconfig && make)
#
# Keep the shared part identical to customos_x86_64_defconfig
# (tests/check-buildroot-config.sh verifies it); OTA additions are at the end and
# marked "OTA:".

# ---- Architecture and toolchain ---------------------------------------------
BR2_x86_64=y
BR2_x86_x86_64_v2=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_V2_GLIBC_STABLE=y
BR2_CCACHE=y
BR2_REPRODUCIBLE=y
# Fixes for Buildroot's own packages: br2-external/patches/<package>/<version>/
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_CUSTOMOS_PATH)/patches"

# ---- System ------------------------------------------------------------------
BR2_TARGET_GENERIC_HOSTNAME="customos"
BR2_TARGET_GENERIC_ISSUE="CustomOS 1.0"
BR2_TARGET_GENERIC_PASSWD_SHA512=y
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD_DEFAULT_TARGET="graphical.target"
BR2_ROOTFS_MERGED_USR=y
BR2_SYSTEM_BIN_SH_BASH=y
BR2_TARGET_GENERIC_GETTY_PORT="tty2"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_ENABLE_LOCALE_WHITELIST="C en_US"
BR2_GENERATE_LOCALE="en_US.UTF-8"
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Etc/UTC"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_CUSTOMOS_PATH)/board/customos/users.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_CUSTOMOS_PATH)/board/customos/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_CUSTOMOS_PATH)/board/customos/post-build.sh"
# OTA: post-image-ota.sh adds the system image to the ISO
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_CUSTOMOS_PATH)/board/customos/post-image.sh $(BR2_EXTERNAL_CUSTOMOS_PATH)/board/customos/ota/post-image-ota.sh"

# ---- Kernel ------------------------------------------------------------------
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
# OTA: dm-verity, squashfs xz, watchdogs
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CUSTOMOS_PATH)/board/customos/linux.fragment $(BR2_EXTERNAL_CUSTOMOS_PATH)/board/customos/ota/linux-ota.fragment"
BR2_LINUX_KERNEL_BZIMAGE=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_81XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8265=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_9XXX=y
BR2_PACKAGE_WIRELESS_REGDB=y

# ---- systemd -----------------------------------------------------------------
BR2_PACKAGE_SYSTEMD_LOGIND=y
BR2_PACKAGE_SYSTEMD_POLKIT=y
BR2_PACKAGE_SYSTEMD_HOSTNAMED=y
BR2_PACKAGE_SYSTEMD_TIMEDATED=y
BR2_PACKAGE_SYSTEMD_TIMESYNCD=y
BR2_PACKAGE_SYSTEMD_LOCALED=y
BR2_PACKAGE_SYSTEMD_HWDB=y
BR2_PACKAGE_SYSTEMD_SYSUSERS=y
BR2_PACKAGE_SYSTEMD_FIRSTBOOT=y
BR2_PACKAGE_SYSTEMD_VCONSOLE=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y

# ---- Graphics stack ------------------------------------------------------------
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SVGA=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y
BR2_PACKAGE_WLROOTS=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y
BR2_PACKAGE_PSPLASH=y
BR2_PACKAGE_PSPLASH_IMAGE="$(BR2_EXTERNAL_CUSTOMOS_PATH)/board/customos/splash.png"
BR2_PACKAGE_PSPLASH_PROGRESS_BAR=y

# ---- Qt 6 ------------------------------------------------------------------------
BR2_PACKAGE_QT6=y
BR2_PACKAGE_QT6BASE_GUI=y
BR2_PACKAGE_QT6BASE_OPENGL=y
BR2_PACKAGE_QT6BASE_OPENGL_ES2=y
BR2_PACKAGE_QT6BASE_LINUXFB=y
BR2_PACKAGE_QT6BASE_EGLFS=y
BR2_PACKAGE_QT6BASE_DEFAULT_QPA="wayland"
BR2_PACKAGE_QT6BASE_FONTCONFIG=y
BR2_PACKAGE_QT6BASE_HARFBUZZ=y
BR2_PACKAGE_QT6BASE_PNG=y
BR2_PACKAGE_QT6BASE_JPEG=y
BR2_PACKAGE_QT6BASE_DBUS=y
BR2_PACKAGE_QT6BASE_NETWORK=y
BR2_PACKAGE_QT6BASE_CONCURRENT=y
BR2_PACKAGE_QT6BASE_XML=y
BR2_PACKAGE_QT6DECLARATIVE=y
BR2_PACKAGE_QT6DECLARATIVE_QUICK=y
BR2_PACKAGE_QT6SVG=y
BR2_PACKAGE_QT6WAYLAND=y
BR2_PACKAGE_QT6SHADERTOOLS=y

# ---- Desktop -----------------------------------------------------------------------
BR2_PACKAGE_MERIDIAN_DESKTOP=y
BR2_PACKAGE_LABWC=y
BR2_PACKAGE_LAYER_SHELL_QT=y
BR2_PACKAGE_SWAYLOCK=y
BR2_PACKAGE_GRIM=y
BR2_PACKAGE_FOOT=y
BR2_PACKAGE_WLR_RANDR=y
BR2_PACKAGE_HICOLOR_ICON_THEME=y
BR2_PACKAGE_SHARED_MIME_INFO=y
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_DBUS=y

# ---- Audio -------------------------------------------------------------------------
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_4=y
BR2_PACKAGE_PIPEWIRE=y
BR2_PACKAGE_WIREPLUMBER=y

# ---- Networking ------------------------------------------------------------------
BR2_PACKAGE_NETWORK_MANAGER=y
BR2_PACKAGE_NETWORK_MANAGER_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_CA_CERTIFICATES=y

# ---- Security / accounts -------------------------------------------------------
BR2_PACKAGE_LINUX_PAM=y
BR2_PACKAGE_LIBXCRYPT=y
BR2_PACKAGE_SHADOW=y
BR2_PACKAGE_SHADOW_SHA_CRYPT=y
BR2_PACKAGE_SUDO=y
BR2_PACKAGE_POLKIT=y

# ---- Base utilities and installer tools -------------------------------------------
BR2_PACKAGE_BASH=y
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_FINDUTILS=y
BR2_PACKAGE_GREP=y
BR2_PACKAGE_SED=y
BR2_PACKAGE_GAWK=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_PSMISC=y
BR2_PACKAGE_KBD=y
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_USBUTILS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_UTIL_LINUX_MOUNTPOINT=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_UTIL_LINUX_WIPEFS=y
BR2_PACKAGE_UTIL_LINUX_AGETTY=y
BR2_PACKAGE_UTIL_LINUX_SU=y
BR2_PACKAGE_UTIL_LINUX_SULOGIN=y
BR2_PACKAGE_UTIL_LINUX_NOLOGIN=y
BR2_PACKAGE_UTIL_LINUX_KILL=y
BR2_PACKAGE_UTIL_LINUX_LOGIN=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_GPTFDISK=y
BR2_PACKAGE_GPTFDISK_SGDISK=y
BR2_PACKAGE_PARTED=y
BR2_PACKAGE_RSYNC=y
BR2_PACKAGE_EFIBOOTMGR=y

# ---- Boot: ISO with GRUB for BIOS and UEFI ---------------------------------------
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_BOOT_PARTITION="cd"
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="boot linux ext2 fat iso9660 part_msdos part_gpt normal biosdisk search search_fs_file configfile echo test reboot halt"
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat iso9660 part_msdos part_gpt normal efi_gop search search_fs_file configfile echo test reboot halt"
BR2_TARGET_GRUB2_BUILTIN_CONFIG_EFI="$(BR2_EXTERNAL_CUSTOMOS_PATH)/board/customos/grub-efi-embedded.cfg"
BR2_TARGET_GRUB2_INSTALL_TOOLS=y
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_GRUB2=y
BR2_TARGET_ROOTFS_ISO9660_BOOT_MENU="$(BR2_EXTERNAL_CUSTOMOS_PATH)/board/customos/grub.cfg"
BR2_TARGET_ROOTFS_ISO9660_INITRD=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_ZSTD=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_XORRISO=y

# ---- OTA: over-the-air updates (A/B layout) ----------------------------------------
BR2_PACKAGE_CUSTOMOS_UPDATER=y
BR2_PACKAGE_CUSTOMOS_UPDATER_REPOSITORY="UralGames/CustomOs"
BR2_PACKAGE_OPENSSL=y
# TLS for the update downloads (Qt Network). Buildroot's defaults keep SSLv3,
# weak ciphers and debug code; none of it is needed.
# BR2_PACKAGE_LIBOPENSSL_ENABLE_SSL is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_SSL3 is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_WEAK_SSL is not set
# BR2_PACKAGE_LIBOPENSSL_UNSECURE is not set
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_RAUC_DBUS=y
BR2_PACKAGE_RAUC_JSON=y
# The system image: written to the A/B slots by the installer and carried by
# the update bundles.
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
# Bundle creation and signing (release/make-release.sh).
BR2_PACKAGE_HOST_RAUC=y
