<?xml version="1.0"?>
<!--
  labwc configuration for the Meridian desktop.

  The copy in ~/.config/labwc/rc.xml is generated by meridian-shell from
  /usr/share/meridian/labwc/rc.xml.in and your choices in Settings
  (~/.config/meridian/desktop.conf). Manual edits there are overwritten;
  to customise further, edit the template or add an environment.d file.
-->
<labwc_config>

  <core>
    <decoration>server</decoration>
    <gap>0</gap>
    <primarySelection>yes</primarySelection>
  </core>

  <placement>
    <policy>cascade</policy>
    <cascadeOffset x="32" y="32" />
  </placement>

  <theme>
    <name>@THEME@</name>
    <icon>Adwaita</icon>
    <fallbackAppIcon>meridian-app</fallbackAppIcon>
    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <cornerRadius>@CORNER_RADIUS@</cornerRadius>
    <keepBorder>yes</keepBorder>
    <maximizedDecoration>titlebar</maximizedDecoration>
    <dropShadows>yes</dropShadows>
    <dropShadowsOnTiled>no</dropShadowsOnTiled>
    <font place="ActiveWindow"><name>Inter</name><size>10</size><weight>normal</weight></font>
    <font place="InactiveWindow"><name>Inter</name><size>10</size><weight>normal</weight></font>
    <font place="MenuHeader"><name>Inter</name><size>10</size><weight>bold</weight></font>
    <font place="MenuItem"><name>Inter</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>Inter</name><size>10</size></font>
  </theme>

  <!-- Alt+Tab: thumbnails of the open windows -->
  <windowSwitcher preview="yes" outlines="yes">
    <osd show="yes" style="thumbnail" output="all" thumbnailLabelFormat="%T" />
    <fields>
      <field content="icon" width="6%" />
      <field content="desktop_entry_name" width="30%" />
      <field content="title" width="64%" />
    </fields>
  </windowSwitcher>

  <resistance>
    <screenEdgeStrength>20</screenEdgeStrength>
    <windowEdgeStrength>20</windowEdgeStrength>
  </resistance>

  <resize>
    <popupShow>Never</popupShow>
    <drawContents>yes</drawContents>
  </resize>

  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <!-- Drag a window to an edge to fill half the screen, to a corner for a
       quarter, to the top edge to maximise. -->
  <snapping>
    <range inner="10" outer="10" />
    <cornerRange>60</cornerRange>
    <overlay enabled="yes">
      <delay inner="250" outer="250" />
    </overlay>
    <topMaximize>yes</topMaximize>
    <notifyClient>always</notifyClient>
  </snapping>

  <!-- Virtual desktops (number set in Settings > Multitasking) -->
  <desktops>
    <popupTime>0</popupTime>
    <names>
      @DESKTOP_NAMES@
    </names>
  </desktops>

  <keyboard>
    <repeatRate>@REPEAT_RATE@</repeatRate>
    <repeatDelay>@REPEAT_DELAY@</repeatDelay>

    <!-- Start menu on a lone Super press -->
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="meridian-shell --action launcher" /></keybind>
    <keybind key="W-s"><action name="Execute" command="meridian-shell --action launcher" /></keybind>
    <keybind key="W-a"><action name="Execute" command="meridian-shell --action quick-settings" /></keybind>
    <keybind key="W-n"><action name="Execute" command="meridian-shell --action notifications" /></keybind>
    <keybind key="W-Tab"><action name="Execute" command="meridian-shell --action task-view" /></keybind>
    <keybind key="W-d"><action name="Execute" command="meridian-shell --action show-desktop" /></keybind>
    <keybind key="W-l"><action name="Execute" command="meridian-shell --action lock" /></keybind>
    <keybind key="Print"><action name="Execute" command="meridian-shell --action screenshot" /></keybind>
    <keybind key="W-S-s"><action name="Execute" command="meridian-shell --action screenshot" /></keybind>

    <!-- Applications -->
    <keybind key="W-Return"><action name="Execute" command="meridian-terminal" /></keybind>
    <keybind key="C-A-t"><action name="Execute" command="meridian-terminal" /></keybind>
    <keybind key="W-e"><action name="Execute" command="meridian-files" /></keybind>
    <keybind key="W-i"><action name="Execute" command="meridian-settings" /></keybind>
    <keybind key="C-S-Escape"><action name="Execute" command="meridian-monitor" /></keybind>

    <!-- Windows -->
    <keybind key="A-Tab"><action name="NextWindow" /></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <keybind key="W-Up"><action name="Maximize" /></keybind>
    <keybind key="W-Down"><action name="UnSnap" /></keybind>
    <keybind key="W-h"><action name="Iconify" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" combine="yes" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" combine="yes" /></keybind>
    <keybind key="A-space"><action name="ShowMenu" menu="client-menu" atCursor="no" /></keybind>

    <!-- Virtual desktops -->
    <keybind key="C-W-Left"><action name="GoToDesktop" to="left" wrap="yes" /></keybind>
    <keybind key="C-W-Right"><action name="GoToDesktop" to="right" wrap="yes" /></keybind>
    <keybind key="S-W-Left"><action name="SendToDesktop" to="left" follow="yes" wrap="yes" /></keybind>
    <keybind key="S-W-Right"><action name="SendToDesktop" to="right" follow="yes" wrap="yes" /></keybind>

    <!-- Taskbar positions -->
    <keybind key="W-1"><action name="Execute" command="meridian-shell --action taskbar-0" /></keybind>
    <keybind key="W-2"><action name="Execute" command="meridian-shell --action taskbar-1" /></keybind>
    <keybind key="W-3"><action name="Execute" command="meridian-shell --action taskbar-2" /></keybind>
    <keybind key="W-4"><action name="Execute" command="meridian-shell --action taskbar-3" /></keybind>
    <keybind key="W-5"><action name="Execute" command="meridian-shell --action taskbar-4" /></keybind>
    <keybind key="W-6"><action name="Execute" command="meridian-shell --action taskbar-5" /></keybind>
    <keybind key="W-7"><action name="Execute" command="meridian-shell --action taskbar-6" /></keybind>
    <keybind key="W-8"><action name="Execute" command="meridian-shell --action taskbar-7" /></keybind>
    <keybind key="W-9"><action name="Execute" command="meridian-shell --action taskbar-8" /></keybind>

    <!-- Hardware keys -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="meridian-shell --action volume-up" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="meridian-shell --action volume-down" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="meridian-shell --action volume-mute" /></keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>

  <libinput>
    <device category="default">
      <naturalScroll>@NATURAL_SCROLL@</naturalScroll>
      <leftHanded>@LEFT_HANDED@</leftHanded>
      <pointerSpeed>@POINTER_SPEED@</pointerSpeed>
      <accelProfile>adaptive</accelProfile>
      <tap>@TAP@</tap>
    </device>
  </libinput>

  <menu>
    <showIcons>yes</showIcons>
  </menu>

</labwc_config>
